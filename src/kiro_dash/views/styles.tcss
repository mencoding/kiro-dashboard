Screen {
    background: $surface;
}

Header {
    background: $primary;
    color: $text;
}

Footer {
    background: $primary-darken-1;
}

TabbedContent {
    height: 1fr;
}

#cycle-banner {
    height: auto;
    padding: 0 1;
    background: $boost;
    color: $text;
}

.warn {
    color: $warning;
}

.danger {
    color: $error;
}
