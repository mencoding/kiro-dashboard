Screen {
    background: $surface;
}

Header {
    background: $primary;
    color: $text;
}

Footer {
    background: $primary-darken-1;
}

TabbedContent {
    height: 1fr;
}

/* TodayTab tem layout horizontal com 2 colunas; sem regra explícita,
   widgets do Vertical interno renderizam 1 char cortado à esquerda. */
TodayTab Static {
    width: 100%;
    margin: 0 1;
}

TodayTab DataTable {
    margin: 0 1;
}

#cycle-banner {
    height: auto;
    padding: 0 1;
    background: $boost;
    color: $text;
}

.warn {
    color: $warning;
}

.danger {
    color: $error;
}

HistoryTab Static {
    width: 100%;
    margin: 0 1;
    padding: 0 1;
}

#history-spark30, #history-spark12m {
    height: auto;
    margin-bottom: 1;
}

#history-compare-row1, #history-compare-row2 {
    height: auto;
    margin: 0 1;
}

.cmp-card {
    width: 1fr;
    height: 7;
    margin: 0 1;
    padding: 0 1;
    border: round $primary;
}
